@page "/yardimci/harita"
@rendermode InteractiveServer
@using Derman.Web.Models
@using Derman.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject ApiClient Api
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Harita</PageTitle>

@if (_isChecking)
{
    <p>Yükleniyor...</p>
}
else if (_isAuthorized)
{
    <div class="container-fluid mt-4">
        <h3>Civardaki Açık Talepler</h3>

        <div class="row mb-3">
            <div class="col-auto">
                <label class="form-label">Konumun (Enlem)</label>
                <input type="number" step="0.0001" class="form-control" @bind="_lat" />
            </div>
            <div class="col-auto">
                <label class="form-label">Konumun (Boylam)</label>
                <input type="number" step="0.0001" class="form-control" @bind="_lng" />
            </div>
            <div class="col-auto d-flex align-items-end">
                <button class="btn btn-primary" @onclick="LoadNearby">Yakındakileri Göster</button>
            </div>
            <div class="col-auto d-flex align-items-end">
                <button class="btn btn-outline-primary" @onclick="LoadWithPriority">AI Önceliklendirme İste</button>
            </div>
        </div>

        
        @if (!string.IsNullOrEmpty(_prioritySummary))
        {
            <div class="alert alert-info">@_prioritySummary</div>
        }

        <div id="@_mapId" style="height: 500px; width: 100%; border-radius: 8px;"></div>
        <div id="@_mapId" style="height: 500px; width: 100%; border-radius: 8px;"></div>

        <div class="mt-3">
            <h5>Açık Talepler</h5>
            @if (_requests.Count == 0)
            {
                <p class="text-muted">Bu bölgede açık talep bulunmuyor.</p>
            }
            else
            {
                <div class="list-group">
                    @foreach (var req in _requests)
                    {
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@req.Category</strong> — @req.SuggestedUrgency<br />
                                    <small class="text-muted">@req.Description</small>
                                </div>
                                <button class="btn btn-sm btn-success" @onclick="() => Claim(req.Id)"
                                        disabled="@_claimingId.HasValue">
                                    @(_claimingId == req.Id ? "İşleniyor..." : "Üstlen")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <p class="text-muted mt-2">@_requests.Count açık talep bulundu.</p>
    </div>
}

@code {
    private bool _isChecking = true;
    private bool _isAuthorized;
    private readonly string _mapId = $"map-{Guid.NewGuid():N}";
    private bool _mapInitialized;

    private double _lat = 37.0662;
    private double _lng = 37.3833;
    private string? _prioritySummary;

    private List<HelpRequestResponseDto> _requests = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true || user.FindFirst("role")?.Value != "Yardimci")
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _isAuthorized = true;
        _isChecking = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _isAuthorized)
        {
            await JS.InvokeVoidAsync("leafletInterop.initMap", _mapId, _lat, _lng, 12, null, false);
            _mapInitialized = true;
            await LoadNearby();
            await ShowMyLiveLocation();
        }
    }

    private async Task ShowMyLiveLocation()
    {
        try
        {
            var coords = await JS.InvokeAsync<double[]>("leafletInterop.getCurrentPosition");
            await JS.InvokeVoidAsync("leafletInterop.setLiveLocationMarker", _mapId, coords[0], coords[1]);
        }
        catch
        {
            // Konum izni verilmediyse sessizce geç, harita yine de çalışsın
        }
    }

    private async Task LoadNearby()
    {
        if (!_mapInitialized) return;

        var latStr = _lat.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var lngStr = _lng.ToString(System.Globalization.CultureInfo.InvariantCulture);

        var response = await Api.GetAsync($"api/help-requests/nearby?lat={latStr}&lng={lngStr}&radiusKm=15");
        if (response.IsSuccessStatusCode)
        {
            _requests = await response.Content.ReadFromJsonAsync<List<HelpRequestResponseDto>>() ?? new();
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"[HARİTA DEBUG] Hata: [{(int)response.StatusCode}] {error}");
        }

        Console.WriteLine($"[HARİTA DEBUG] {_requests.Count} talep bulundu. Aranan konum: {_lat}, {_lng}");

        await RenderMarkers();
    }

    private async Task LoadWithPriority()
    {
        var latStr = _lat.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var lngStr = _lng.ToString(System.Globalization.CultureInfo.InvariantCulture);

        var response = await Api.GetAsync($"api/help-requests/nearby/priority?lat={latStr}&lng={lngStr}&radiusKm=15");
        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<PriorityResult>();
            if (result is not null)
            {
                _prioritySummary = result.Summary;
                _requests = result.Requests;
            }
        }

        await RenderMarkers();
    }

    private async Task RenderMarkers()
    {
        await JS.InvokeVoidAsync("leafletInterop.clearMarkers", _mapId);

        foreach (var req in _requests)
        {
            var popup = $"<b>{req.Category}</b><br/>{req.Description}<br/>Aciliyet: {req.SuggestedUrgency}";
            var iconType = (req.SuggestedUrgency ?? "default").ToLowerInvariant();
            await JS.InvokeVoidAsync("leafletInterop.addMarker", _mapId, (double)req.Latitude, (double)req.Longitude, popup,
    iconType);
        }

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_mapInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("leafletInterop.destroyMap", _mapId);
            }
            catch (JSDisconnectedException)
            {
                // Sayfa zaten kapanıyor, JS bağlantısı koptu — güvenle yok sayılabilir
            }
        }
    }

    public class PriorityResult
    {
        public string Summary { get; set; } = string.Empty;
        public List<Guid> PriorityRequestIds { get; set; } = new();
        public List<HelpRequestResponseDto> Requests { get; set; } = new();
    }
    private Guid? _claimingId;

    private async Task Claim(Guid requestId)
    {
        _claimingId = requestId;

        try
        {
            var dto = new CreateMatchDto(requestId);
            var response = await Api.PostAsync("api/matches", dto);

            if (response.IsSuccessStatusCode)
            {
                await LoadNearby(); // Listeyi yenile, talep artık "OnayBekliyor" olduğu için listeden düşecek
            }
        }
        finally
        {
            _claimingId = null;
        }
    }
}