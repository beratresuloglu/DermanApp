    <ReconnectModal />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
    <script src="js/leafletInterop.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
