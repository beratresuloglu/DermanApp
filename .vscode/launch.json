{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Derman.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/src/Derman.Api/bin/Debug/net10.0/Derman.Api.dll",
      "cwd": "${workspaceFolder}/src/Derman.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "internalConsole"
    },
    {
      "name": "Derman.Web",
  "type": "coreclr",
  "request": "launch",
  "preLaunchTask": "build-web",
  "program": "${workspaceFolder}/src/Derman.Web/bin/Debug/net10.0/Derman.Web.dll",
  "cwd": "${workspaceFolder}/src/Derman.Web",
  "env": {
    "ASPNETCORE_ENVIRONMENT": "Development"
  },
  "console": "internalConsole",
  "serverReadyAction": {
    "action": "openExternally",
    "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
  }
    }
  ],
  "compounds": [
    {
      "name": "Derman.Api + Derman.Web",
      "configurations": ["Derman.Api", "Derman.Web"]
    }
  ]
}